# ZYND Backend Environment
APP_NAME="ZYND API"
APP_ENV=development
DEBUG=true
# Set true only when debugging SQL queries (very verbose)
DATABASE_ECHO=false

# Development only — fixed OTP for email/mobile verification (requires DEBUG=true)
DEV_OTP=123456
# Development only — bypass Redis rate limits (signup, login, OTP send, forgot password)
DEV_SKIP_RATE_LIMITS=false
# Development only — seeded admin account (admin@zynd.com / 12345678) on API startup
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS — comma-separated origins (User Web + Admin Web)
CORS_ORIGINS=http://localhost:7777,http://localhost:8888,http://127.0.0.1:7777,http://127.0.0.1:8888

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://zynd:zynd@localhost:5432/zynd

# Redis (local)
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_EVENT_STREAM_DB=3

# Security (generate in production)
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password breach check (HIBP k-anonymity API)
HIBP_ENABLED=true

# OTP send rate limits (per identifier and per IP, within window)
OTP_SEND_LIMIT_PER_IDENTIFIER=5
OTP_SEND_LIMIT_PER_IP=20
OTP_SEND_WINDOW_SECONDS=3600

# MFA — use versioned keys in production, e.g. MFA_ENCRYPTION_KEYS='{"1":"old-key","2":"new-key"}'
MFA_ENCRYPTION_KEY=change-me-mfa-key-in-production
MFA_ENCRYPTION_KEYS=
CURRENT_MFA_KEY_VERSION=1
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_KEYS=
CURRENT_PII_KEY_VERSION=1
SECRETS_PROVIDER=local
VAULT_ADDR=
AWS_SECRETS_ARN=
ANONYMIZED_EMAIL_DOMAIN=zynd.invalid
DELETION_EXECUTOR_BATCH_SIZE=50

# JWT — RS256 in production; leave key files/PEMs empty to fall back to HS256 + SECRET_KEY
JWT_PRIVATE_KEY_FILE=privateKey.pem
JWT_PUBLIC_KEY_FILE=publicKey.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ALGORITHM=RS256
JWT_KID=zynd-1

# Secrets providers: local | vault | aws
VAULT_TOKEN=
VAULT_MOUNT=secret
AWS_REGION=

# Deletion executor scheduler (used by docker-compose deletion-cron)
DELETION_EXECUTOR_INTERVAL_SECONDS=3600

# Mongo analytics export (optional — async one-way ETL)
MONGO_URL=
MONGO_DB_NAME=zynd_analytics
MONGO_EXPORT_BATCH_SIZE=500

FRONTEND_URL=http://localhost:7777
ADMIN_FRONTEND_URL=http://localhost:8888
REFERRAL_MIN_FIRST_INVESTMENT_INR=1000
REFERRAL_QUALIFICATION_HOLD_DAYS=30
REFERRAL_MIN_ENGAGEMENT_INVESTMENT_INR=1000
REFERRAL_AUM_MILESTONE_INR=100000
REFRESH_COOKIE_SECURE=false

# Email delivery (SMTP). Leave SMTP_HOST empty to log/publish events only in development.
# Alternatively, set BREVO_SMTP_KEY (+ login/from) and leave SMTP_* empty — Brevo relay is applied automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=security@zynd.co

# Brevo transactional email (https://app.brevo.com) — verified sender on your domain
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
BREVO_FROM=Zynd Support <support@zynd.shop>

# Event-driven (Phase 3 — transactional outbox)
EVENT_BUS_ADAPTER=redis
EVENT_STREAM_PREFIX=zynd
# Use sync in local dev so signup/OTP emails send immediately without a worker.
# Set EVENT_USE_WORKER_IN_DEV=true to test outbox + worker flow locally.
EVENT_DISPATCH_MODE=sync
EVENT_USE_WORKER_IN_DEV=false
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_MAX_ATTEMPTS=10
OUTBOX_RELAY_INTERVAL_SECONDS=5

# OTP / SMS
# SMS_PROVIDER: empty (dev log when DEBUG=true), stub (log only), or twilio
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender, e.g. +15017122661 — required unless TWILIO_MESSAGING_SERVICE_SID is set
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Document storage (Phase 0 local filesystem; Phase 1 dual-bucket + optional S3)
DOCUMENTS_ROOT=documents
DOCUMENTS_MAX_BYTES=10485760
DOCUMENTS_PROFILE_IMAGE_MAX_BYTES=4194304
DOCUMENTS_PROFILE_IMAGE_MIN_DIMENSION=128
DOCUMENTS_PROFILE_IMAGE_MAX_DIMENSION=2048
DOCUMENTS_PROFILE_IMAGE_UPLOAD_LIMIT=10
DOCUMENTS_PROFILE_IMAGE_UPLOAD_WINDOW_SECONDS=3600
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENTS_LOCAL_ENCRYPT_PII=true
PII_DOCUMENTS_BUCKET=zynd-pii-documents
PUBLIC_ASSETS_BUCKET=zynd-public-assets
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
KMS_KEY_ID_PII=
KMS_KEY_ID_PUBLIC=
DOCUMENTS_DOWNLOAD_URL_TTL_SECONDS=300
API_PUBLIC_URL=http://localhost:8000/api/v1
DOCUMENT_SCAN_DISPATCH_MODE=async
# In development, scans run synchronously unless you set this when using docker scan worker:
# DOCUMENT_SCAN_USE_WORKER_IN_DEV=true
REDIS_DOCUMENT_WORKER_DB=4
DOCUMENTS_SCAN_QUEUE_KEY=zynd:documents:scan
DOCUMENTS_SCAN_DEAD_LETTER_KEY=zynd:documents:scan:dead
DOCUMENTS_SCAN_MAX_ATTEMPTS=5
DOCUMENTS_SCAN_WORKER_BLOCK_SECONDS=5

# ClamAV malware scanning (Phase 4)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_FAIL_OPEN=false

# Phase 7 — WORM / object lock (enable S3 lock in production)
DOCUMENTS_WORM_S3_OBJECT_LOCK_ENABLED=false
DOCUMENTS_WORM_RETENTION_DAYS=0

# Phase 9 — CDN for non-PII public assets (profile_image only)
# Local dev fallback: http://localhost:8000/api/v1/documents/public
# Production: https://cdn.yourdomain.com
DOCUMENTS_CDN_BASE_URL=
DOCUMENTS_PUBLIC_CACHE_MAX_AGE_SECONDS=2592000

# KYC — Kyckart + Cybrilla POA + FinPrim (auto uses stub when keys are absent in development)
# Store test and live credential sets; unsuffixed legacy vars (e.g. FP_BASE_URL) map to live only.
# Test mode requires *_TEST suffixed vars. Switch active mode from Admin → Zynd Integrations.
KYC_PROVIDER_MODE=auto
# Kyckart (PAN name/DOB + optional bank holder prefill)
KYCKART_BASE_URL=
KYCKART_API_KEY=
KYCKART_BASE_URL_TEST=
KYCKART_API_KEY_TEST=
KYCKART_BASE_URL_LIVE=
KYCKART_API_KEY_LIVE=
# Default path used by Zynd: /api/bank/pennyLessV4 (body: accountNumber + ifsc)
# KYCKART_BANK_VERIFICATION_PATH=/api/bank/pennyLessV4
FP_POA_TOKEN_BASE_URL=
FP_POA_CLIENT_ID=
FP_POA_CLIENT_SECRET=
FP_POA_BASE_URL=https://api.cybrilla.com
FP_POA_AUTH_TENANT=cybrillapoa
FP_POA_TOKEN_BASE_URL_TEST=
FP_POA_CLIENT_ID_TEST=
FP_POA_CLIENT_SECRET_TEST=
FP_POA_BASE_URL_TEST=
FP_POA_AUTH_TENANT_TEST=
FP_POA_TOKEN_BASE_URL_LIVE=
FP_POA_CLIENT_ID_LIVE=
FP_POA_CLIENT_SECRET_LIVE=
FP_POA_BASE_URL_LIVE=
FP_POA_AUTH_TENANT_LIVE=
FP_BASE_URL=
FP_TENANT=
FP_CLIENT_ID=
FP_CLIENT_SECRET=
FP_BASE_URL_TEST=
FP_TENANT_TEST=
FP_CLIENT_ID_TEST=
FP_CLIENT_SECRET_TEST=
FP_WEBHOOK_SECRET_TEST=
FP_WEBHOOK_CALLBACK_URL_TEST=
DIGILOCKER_FP_TENANT_TEST=
FP_BASE_URL_LIVE=
FP_TENANT_LIVE=
FP_CLIENT_ID_LIVE=
FP_CLIENT_SECRET_LIVE=
FP_WEBHOOK_SECRET_LIVE=
FP_WEBHOOK_CALLBACK_URL_LIVE=
DIGILOCKER_FP_TENANT_LIVE=
FP_ENABLED=false
FP_TOKEN_CACHE_MINUTES=25
FP_WEBHOOK_SECRET=
FP_WEBHOOK_CALLBACK_URL=
DIGILOCKER_FP_TENANT=
KYC_DIGILOCKER_CALLBACK_URL=
KYC_PROOF_CALLBACK_URL=
KYC_ESIGN_CALLBACK_URL=
# Poll KRA readiness automatically when form status is checked (default true)
KYC_AUTO_KRA_CHECK_ENABLED=true

# Firebase Cloud Messaging (Phase 2 — mobile push delivery layer)
# Keep disabled until Firebase service account is configured.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Inline JSON or path to service account file (same pattern as JWT keys)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Notification platform hardening (Phase 5)
NOTIFICATIONS_UNREAD_CACHE_ENABLED=true
NOTIFICATIONS_UNREAD_CACHE_TTL_SECONDS=604800
NOTIFICATIONS_PUSH_QUEUE_KEY=zynd:notifications:push
NOTIFICATIONS_PUSH_DEAD_LETTER_KEY=zynd:notifications:push:dead
NOTIFICATIONS_PUSH_MAX_ATTEMPTS=5
NOTIFICATIONS_PUSH_WORKER_BLOCK_SECONDS=5
NOTIFICATIONS_RETENTION_PURGE_BATCH_SIZE=500

# =============================================================================
# Mutual fund ingestion — Cybrilla scheme sync + AMFI NAV overlay
# Cybrilla is scheme master (ARN-scoped tenant). AMFI only adds NAV by ISIN.
# =============================================================================
ZYND_DISTRIBUTOR_ARN=
ZYND_DISTRIBUTOR_EUIN=
ZYND_MF_INGESTION_ENABLED=true
ZYND_MF_SCHEME_SYNC_ENABLED=true
ZYND_MF_SCHEME_SYNC_CRON=0 20 * * *
ZYND_MF_SCHEME_SYNC_BATCH_SIZE=100
ZYND_MF_NAV_INGESTION_ENABLED=true
ZYND_MF_NAV_CRON=0 21 * * *
ZYND_MF_AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
ZYND_MF_FETCH_TIMEOUT_SECONDS=60
ZYND_MF_NAV_BATCH_SIZE=500
ZYND_MF_NAV_WRITE_CHUNK_SIZE=50
ZYND_MF_MIN_NAV_RECORD_COUNT=5000
ZYND_MF_MIN_FILE_SIZE_BYTES=512000
# Skip NAV rows older than N days during amfi-nav-daily (use 30–90 for dev if index/NFO funds show stale NAV)
ZYND_MF_NAV_MAX_AGE_DAYS=1
ZYND_MF_NAV_ISIN_MATCH_ONLY=true
ZYND_MF_COLD_START_BACKFILL_ENABLED=true
ZYND_MF_COLD_START_BACKFILL_THRESHOLD=1000
ZYND_MF_COLD_START_BACKFILL_FROM_DATE=2006-04-01
ZYND_MF_COLD_START_BACKFILL_DAYS_PER_WINDOW=90
ZYND_MF_COLD_START_BACKFILL_CRON=30 18 * * *
ZYND_MF_COLD_START_ON_STARTUP=true
ZYND_MF_DEPENDENCY_GUARD_ENABLED=true
ZYND_MF_DEPENDENCY_LOOKBACK_HOURS=24
ZYND_MF_STALE_RUN_CLEANUP_ENABLED=true
ZYND_MF_STALE_RUN_CLEANUP_CRON=0 */2 * * *
ZYND_MF_STALE_RUN_CLEANUP_THRESHOLD_HOURS=3
ZYND_MF_AUM_CRON=0 9 1 * *
ZYND_MF_AMFI_AUM_URL=https://www.amfiindia.com/aum-data/aum-disclosure
ZYND_MF_AUM_INGESTION_ENABLED=true
ZYND_MF_TER_CRON=0 10 1 * *
ZYND_MF_TER_INGESTION_ENABLED=true
ZYND_MF_TER_PAGE_SIZE=500
ZYND_MF_TER_MAX_PAGES=0
ZYND_MF_TER_FINANCIAL_YEAR=2025-2026
ZYND_MF_TER_MONTH=
ZYND_MF_TER_TRACKER_URL=
ZYND_MF_AMFI_AUM_SCHEME_WISE_DATA_URL=
ZYND_MF_AAUM_ENABLED=true
ZYND_MF_AAUM_CRON=30 11 15 1,4,7,10 *
ZYND_MF_AAUM_STR_TYPE=Categorywise
ZYND_MF_AAUM_FY_ID=
ZYND_MF_AAUM_PERIOD_ID=
ZYND_MF_AMFI_AAUM_BASE_URL=https://www.amfiindia.com
ZYND_MF_METRICS_ENABLED=true
ZYND_MF_METRICS_CRON=0 22 * * *
ZYND_MF_RANK_CRON=30 23 * * *
ZYND_MF_METRICS_BATCH_SIZE=50
ZYND_MF_COLLECTIONS_ENABLED=true
ZYND_MF_COLLECTION_TOP_N=25
ZYND_MF_COLLECTION_BEST_SIP_MAX_MIN_INR=500
ZYND_MF_CLASSIFICATION_CRON=15 22 * * *
ZYND_MF_COLLECTION_ASSIGN_CRON=25 22 * * *
ZYND_MF_RAW_BUCKET=zynd-mf-raw
ZYND_MF_RAW_ARCHIVE_OBJECT_STORAGE_ENABLED=true
ZYND_MF_SCHEDULER_TICK_SECONDS=60
ZYND_MF_CATALOG_LIFECYCLE_ENABLED=true
ZYND_MF_CATALOG_LIFECYCLE_CRON=15 20 * * *
ZYND_MF_AMC_LOGO_INGEST_ENABLED=false
ZYND_MF_AMC_LOGO_INGEST_CRON=0 6 * * 1
ZYND_MF_AMC_LOGO_URL_TEMPLATE=
ZYND_MF_AMC_LOGO_MANIFEST_URL=
# Local dev: JSON map of slug -> file:logos/<slug>.svg under Backend/assets/amc-logos/
ZYND_MF_AMC_LOGO_MANIFEST_PATH=
ZYND_MF_CATALOG_HEALTH_GATES_ENABLED=true
ZYND_MF_NAV_STALE_DAYS=3
ZYND_MF_MIN_NAV_ROWS=50
ZYND_MF_ORDERS_ENABLED=true
ZYND_MF_ORDER_WORKER_TICK_SECONDS=30
ZYND_MF_ORDER_WORKER_BATCH_SIZE=20
# Minimum seconds between Finprim GET /api/pg/mandates/{id} polls per mandate (worker + webhooks still apply updates).
ZYND_MF_MANDATE_SYNC_INTERVAL_SECONDS=300
ZYND_MF_WORKER_AUTOSTART=true
ZYND_MF_ORDER_STATUS_SYNC_ENABLED=true
ZYND_MF_ORDER_PAYMENT_GATEWAY=ondc
ZYND_MF_CART_MAX_ITEMS=10
ZYND_MF_SIP_ENABLED=true
ZYND_MF_MANDATE_PROVIDER=CYBRILLAPOA
ZYND_MF_SIP_DEFAULT_MANDATE_LIMIT_INR=15000
ZYND_MF_SIP_DEFAULT_MONTHLY_INSTALLMENTS=360
ZYND_MF_SIP_DEFAULT_DAILY_INSTALLMENTS=365
ZYND_MF_PAYMENT_EXPIRY_MINUTES=1440
ZYND_MF_STUCK_TRANSACTION_MINUTES=60
ZYND_MF_WORKER_MAX_TRANSIENT_RETRIES=5
ZYND_MF_WEBHOOK_REPLAY_ENABLED=true
ZYND_MF_WEBHOOK_REPLAY_BATCH_SIZE=10
ZYND_MF_PAYMENT_POSTBACK_URL=
ZYND_MF_PAYMENT_POSTBACK_PATH=/dashboard/mutual-funds/orders/payment-return
ZYND_INVESTOR_PROVISION_ENABLED=true
ZYND_INVESTOR_PROVISION_BATCH_SIZE=10
ZYND_MF_CAS_ENABLED=false
ZYND_MF_CENTRAL_BASE_URL=
ZYND_MF_CENTRAL_API_KEY=
ZYND_MF_CAS_WORKER_TICK_SECONDS=60
ZYND_MF_CAS_WORKER_BATCH_SIZE=10
ZYND_MF_SCHEME_MIN_AMOUNTS_BACKFILL_ENABLED=true
ZYND_MF_SCHEME_MIN_AMOUNTS_BACKFILL_CRON=15 21 * * *
ZYND_MF_SCHEME_MIN_AMOUNTS_BACKFILL_BATCH_SIZE=200

# FinPrim MF tenant (scheme sync + orders) — enable explicitly for live
FP_ENABLED=false
FP_TOKEN_CACHE_MINUTES=25
# Finprim webhook HMAC secret (from Cybrilla support) — required for live webhook verification
FP_WEBHOOK_SECRET=
# Override public webhook URL registered in Finprim dashboard (default: {API_PUBLIC_URL}/webhooks/finprim)
FP_WEBHOOK_CALLBACK_URL=

# Mongo — raw MF ingestion archive (optional; also used for analytics export)
MONGO_CONN=
MONGO_URL=
MONGO_MF_RAW_DB=zynd_mf_raw
ZYND_MF_RAW_BUCKET=zynd-mf-raw

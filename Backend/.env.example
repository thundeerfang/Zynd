# ZYND Backend Environment
APP_NAME="ZYND API"
APP_ENV=development
DEBUG=true

# Development only — fixed OTP for email/mobile verification (requires DEBUG=true)
DEV_OTP=123456
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS — comma-separated origins (User Web + Admin Web)
CORS_ORIGINS=http://localhost:7777,http://localhost:8888,http://127.0.0.1:7777,http://127.0.0.1:8888

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://zynd:zynd@localhost:5432/zynd

# Redis (local)
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2
REDIS_EVENT_STREAM_DB=3

# Security (generate in production)
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
TURNSTILE_SECRET_KEY=

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# MFA — use a dedicated secret in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
MFA_ENCRYPTION_KEY=change-me-mfa-key-in-production
MAX_CONCURRENT_SESSIONS=3

FRONTEND_URL=http://localhost:7777
REFRESH_COOKIE_SECURE=false

# Event-driven (Phase 1 — Redis Streams)
EVENT_BUS_ADAPTER=redis
EVENT_STREAM_PREFIX=zynd
